  "cards": [
    {
      "dot": "cyan",
      "title": "Choose a useful signal",
      "items": [
        "Request rate, queue depth, concurrency, or utilization must correlate with capacity",
        "Scheduled changes prepare for known demand; desired capacity is a target, not a guarantee"
      ]
    },
    {
      "dot": "amber",
      "title": "Prevent oscillation",
      "items": [
        "Evaluation windows, hysteresis, warmup, and cooldown stop rapid scale-out and scale-in",
        "Scale-in drains work before termination; scale-out waits for traffic readiness"
      ]
    },
    {
      "dot": "violet",
      "title": "A separate decision",
      "items": [
        "Replacing an unhealthy instance is self-healing, not evidence that demand increased",
        "A platform may use the same group controller for both operations"
      ]
